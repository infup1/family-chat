        function changeRoomCode() \{\
            const newCode = prompt("\uc0\u35831 \u36755 \u20837 \u24744 \u21644 \u23478 \u20154 \u30340 \u19987 \u23646 \u25151 \u38388 \u21495 \u65288 \u33521 \u25991 \u25110 \u25968 \u23383 \u65289 \u65306 ", roomCode);\
