        function initCloudSync() \{\
            document.getElementById('displayRoomCode').innerText = roomCode;\
            localStorage.setItem('family_room_code', roomCode);\
\
            const localCached = localStorage.getItem(`family_cache_$\{roomCode\}`);\
            if (localCached) \{\
                try \{ globalState = JSON.parse(localCached); \} catch (e) \{\}\
            \}\
\
            renderAllComponents();\
\
            const brokerUrl = 'wss://broker.emqx.io:8084/mqtt';\
            const clientId = 'family_client_' + Math.random().toString(16).substr(2, 8);\
            const topic = `family_consensus_hub_v1/$\{roomCode\}`;\
\
            const dot = document.getElementById('syncStatusDot');\
            const txt = document.getElementById('syncStatusText');\
\
            try \{\
                mqttClient = mqtt.connect(brokerUrl, \{ clientId, clean: true, reconnectPeriod: 3000 \});\
                mqttClient.on('connect', () => \{\
                    dot.className = 'status-dot online';\
                    txt.innerText = '\uc0\u20113 \u31471 \u23454 \u26102 \u20114 \u32852 \u20013 ';\
                    mqttClient.subscribe(topic, \{ qos: 1 \});\
                    broadcastSyncAction(\{ type: 'PING_REQUEST' \});\
                \});\
                mqttClient.on('message', (t, payload) => \{\
                    try \{ handleCloudBroadcast(JSON.parse(payload.toString())); \} catch (e) \{\}\
                \});\
                mqttClient.on('reconnect', () => \{ dot.className = 'status-dot'; txt.innerText = '\uc0\u27491 \u22312 \u37325 \u36830 \u20113 \u31471 ...'; \});\
                mqttClient.on('offline', () => \{ dot.className = 'status-dot'; txt.innerText = '\uc0\u24050 \u31163 \u32447  (\u26412 \u22320 \u27169 \u24335 )'; \});\
            \} catch (err) \{\
                dot.className = 'status-dot';\
                txt.innerText = '\uc0\u31163 \u32447 \u36816 \u34892 \u20013 ';\
            \}\
        \}\
\
        function broadcastSyncAction(actionPayload) \{\
            actionPayload.fromClientId = mqttClient ? mqttClient.options.clientId : 'local';\
            actionPayload.timestamp = Date.now();\
            localStorage.setItem(`family_cache_$\{roomCode\}`, JSON.stringify(globalState));\
            if (mqttClient && mqttClient.connected) \{\
                mqttClient.publish(`family_consensus_hub_v1/$\{roomCode\}`, JSON.stringify(actionPayload), \{ qos: 1 \});\
            \}\
        \}\
\
        function handleCloudBroadcast(data) \{\
            if (mqttClient && data.fromClientId === mqttClient.options.clientId) return;\
            if (data.type === 'FULL_SYNC_STATE') \{\
                globalState = data.state;\
                localStorage.setItem(`family_cache_$\{roomCode\}`, JSON.stringify(globalState));\
                renderAllComponents();\
            \} else if (data.type === 'PING_REQUEST') \{\
                broadcastSyncAction(\{ type: 'FULL_SYNC_STATE', state: globalState \});\
            \} else if (data.type === 'CHAT_MESSAGE') \{\
                if (!globalState.chatRooms[data.roomId]) globalState.chatRooms[data.roomId] = [];\
                globalState.chatRooms[data.roomId].push(data.msg);\
                if (data.roomId === currentRoomId) renderChatStream();\
            \} else if (data.type === 'UPDATE_ROLE_CONFIG') \{\
                globalState.roomRoles[data.roomId] = data.roleCfg;\
                if (data.roomId === currentRoomId) document.getElementById('curRoomRoleTag').innerText = data.roleCfg.tag;\
            \} else if (data.type === 'ADD_PROBLEM_ROW') \{\
                globalState.problemTables[data.person].push(data.row);\
                renderTables();\
            \} else if (data.type === 'ADD_PROFILE_ITEM') \{\
                globalState.profileList.push(data.item);\
                renderProfiles();\
            \} else if (data.type === 'ADD_CONSENSUS') \{\
                globalState.consensusList.push(data.item);\
