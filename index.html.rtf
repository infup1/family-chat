        async function callRealAiApi(userMsg, roomRolePrompt) \{\
            const apiKey = localStorage.getItem('hub_api_key');\
            let baseUrl = localStorage.getItem('hub_api_url') || 'https://api.deepseek.com/v1';\
            const model = localStorage.getItem('hub_api_model') || 'deepseek-chat';\
            if (!baseUrl.endsWith('/chat/completions')) baseUrl = baseUrl.replace(/\\/+$/, '') + '/chat/completions';\
\
            const profileTexts = globalState.profileList.map(item => `$\{item.title\}: $\{item.desc\}`).join('\\n');\
            const systemPrompt = `\uc0\u12304 \u20320 \u22312 \u24403 \u21069 \u31383 \u21475 \u30340 \u19987 \u23646 \u35282 \u33394 \u23450 \u20301 \u19982 \u25351 \u20196 \u12305 \u65306 \\n$\{roomRolePrompt\}\\n\\n\u12304 \u36890 \u29992 \u32972 \u26223 \u19982 \u23478 \u24237 \u24213 \u29260 \u25968 \u25454 \u12305 \u65306 \\n$\{profileTexts\}\\n\\n\u12304 \u36755 \u20986 \u26684 \u24335 \u35201 \u27714 \u12305 \u65306 \\n\u35831 \u21153 \u24517 \u20351 \u29992 \u36890 \u20439 \u12289 \u21475 \u35821 \u21270 \u30340 \u22823 \u30333 \u35805 \u65292 \u24182 \u20005 \u26684 \u36755 \u20986 \u20197 \u19979  JSON \u26684 \u24335 \u65306 \\n\{\\n  "flawAnalysis": "\u32467 \u21512 \u20320 \u30340 \u35282 \u33394 \u35774 \u23450 \u65292 \u23458 \u35266 \u25351 \u20986 \u21018 \u25165 \u21457 \u35328 \u20013 \u35841 \u22312 \u21738 \u21477 \u35805 \u26377 \u20160 \u20040 \u36923 \u36753 \u38382 \u39064 \u25110 \u38656 \u35201 \u27880 \u24847 \u30340 \u22320 \u26041 \u65288 \u22823 \u30333 \u35805 \u30452 \u25509 \u25351 \u26126 \u65289 ",\\n  "currentEvent": "\u19968 \u21477 \u35805 \u27010 \u25324 \u24403 \u21069 \u20105 \u25191 \u30340 \u26680 \u24515 \u20107 \u20214 ",\\n  "actualDemands": "\u21452 \u26041 \u21508 \u33258 \u30495 \u27491 \u24819 \u35201 \u30340 \u23454 \u38469 \u38656 \u27714 \u65288 \u19981 \u24102 \u24773 \u32490 \u65289 ",\\n  "nextStep": "\u20855 \u20307 \u30340 \u19968 \u27493 \u34892 \u21160 \u24314 \u35758 "\\n\}`;\
\
            const response = await fetch(baseUrl, \{\
                method: 'POST',\
                headers: \{ 'Content-Type': 'application/json', 'Authorization': `Bearer $\{apiKey\}` \},\
                body: JSON.stringify(\{\
                    model: model,\
                    messages: [\{ role: 'system', content: systemPrompt \}, \{ role: 'user', content: userMsg \}],\
                    temperature: 0.3\
                \})\
            \});\
\
            if (!response.ok) throw new Error(`API \uc0\u21709 \u24212 \u38169 \u35823 \u65306 $\{response.statusText\}`);\
            const data = await response.json();\
            const rawContent = data.choices[0].message.content;\
            try \{\
                return JSON.parse(rawContent.replace(/```json/g, '').replace(/```/g, '').trim());\
            \} catch (e) \{\
                return \{ flawAnalysis: rawContent, currentEvent: "\uc0\u23454 \u26102 \u20132 \u27969 \u26803 \u29702 ", actualDemands: "\u20114 \u30456 \u21548 \u25026 \u23545 \u26041 \u35785 \u27714 ", nextStep: "\u19968 \u27425 \u21482 \u35848 \u19968 \u20214 \u20107 " \};\
            \}\
        \}\
